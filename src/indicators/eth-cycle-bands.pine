// IVth Legion — ETH Cycle Bands (logarithmic regression, fitted to ETH's real cycle tops and lows)
//
// Each line:  price = 10 ^ (a * ln(x) + c),   x = days since 21 Jan 2015
// The two lines of a band share the same slope a, so the band keeps the same width over time.
// For every slope we pushed the two lines as close together as possible while still holding every
// cycle top (red) or every cycle low (green), and kept the narrowest band.
//
//   Top band (red)      a = 0.428   c = +0.1596 .. +0.3413   (1.52x wide)
//     lower edge through the Jan 2018 ($1,420) and Aug 2025 ($4,955) tops,
//     upper edge through the Nov 2021 top ($4,869); ETH has never traded above it since 2016
//   Bottom band (green) a = 1.448   c = -8.9695 .. -8.4989   (2.96x wide)
//     lower edge through the 13 Mar 2020 wick ($88.20), no day in ETH's history traded below it;
//     upper edge through the 2015 and Jun 2022 ($880) lows
//
// Tops have flattened since 2021 while the lows keep rising, so the bands squeeze together and
// meet around May 2028: ETH's cycle range is getting tighter.
// The bands depend only on the date: use it on ETHUSD, log scale, daily or weekly.
//
//@version=5
indicator("IVth Legion ETH Cycle Bands", shorttitle="IVL ETH Cycle", overlay=true)

aTop   = input.float(0.428, "Top band slope a", step=0.001)
cTopHi = input.float(0.3413, "Top band upper c", step=0.001, tooltip="+0.3413 = through the Nov 2021 top")
cTopLo = input.float(0.1596, "Top band lower c", step=0.001, tooltip="+0.1596 = through the Jan 2018 and Aug 2025 tops")
aBot   = input.float(1.448, "Bottom band slope a", step=0.001)
cBotHi = input.float(-8.4989, "Bottom band upper c", step=0.001, tooltip="-8.4989 = through the 2015 and Jun 2022 lows")
cBotLo = input.float(-8.9695, "Bottom band lower c", step=0.001, tooltip="-8.9695 = through the Mar 2020 wick ($88.20)")
showTbl = input.bool(true, "Show table")

origin = timestamp("UTC", 2015, 1, 21, 0, 0)
xDays  = (time - origin) / 86400000.0
lnx    = xDays > 1 ? math.log(xDays) : na
bandAt(a, c) => math.pow(10, a * lnx + c)

tHi = bandAt(aTop, cTopHi)
tLo = bandAt(aTop, cTopLo)
bHi = bandAt(aBot, cBotHi)
bLo = bandAt(aBot, cBotLo)

cRed = #ef5350
cGrn = #2ecc71
p1 = plot(tHi, "Top band, upper", color=cRed)
p2 = plot(tLo, "Top band, lower", color=cRed)
p3 = plot(bHi, "Bottom band, upper", color=cGrn)
p4 = plot(bLo, "Bottom band, lower", color=cGrn)
fill(p1, p2, color=color.new(cRed, 82), title="Top band")
fill(p3, p4, color=color.new(cGrn, 85), title="Bottom band")

zone = close > tHi ? "Above the top band" : close >= tLo ? "Inside the top band" : close > bHi ? "Between the bands" : close >= bLo ? "Inside the bottom band" : "Below the bottom band"
zoneCol = close >= tLo ? cRed : close > bHi ? color.orange : close >= bLo ? cGrn : #00c2ff

fmt(v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.0") + "%"
usd(v) => "$" + str.tostring(v, v >= 1000 ? "#,###" : "#.##")
var table tb = table.new(position.bottom_right, 3, 6, bgcolor=color.new(#0d0d18, 10), border_color=color.new(#ffffff, 85), border_width=1)
if showTbl and barstate.islast
    table.cell(tb, 0, 0, "Band", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 0, "Today", text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 0, "Price vs band", text_color=color.silver, text_size=size.small)
    names = array.from("Top, upper", "Top, lower", "Bottom, upper", "Bottom, lower")
    vals = array.from(tHi, tLo, bHi, bLo)
    for i = 0 to 3
        v = array.get(vals, i)
        table.cell(tb, 0, i + 1, array.get(names, i), text_color=i < 2 ? cRed : cGrn, text_size=size.small)
        table.cell(tb, 1, i + 1, usd(v), text_color=color.white, text_size=size.small)
        table.cell(tb, 2, i + 1, fmt((close / v - 1) * 100), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 5, zone, text_color=zoneCol, text_size=size.small)
    table.merge_cells(tb, 0, 5, 2, 5)

alertcondition(ta.crossunder(low, bHi), "ETH entered the bottom band", "ETH traded down into the green bottom band (cycle-low zone)")
alertcondition(ta.crossover(high, tLo), "ETH entered the top band", "ETH traded up into the red top band (cycle-top zone)")
alertcondition(ta.crossunder(low, bLo), "ETH below the bottom band", "ETH traded below the bottom band, lower than any day in its history")
