// IVth Legion — ETH Cycle Bands
//
// Rebuilds the open-source "Ethereum Logarithmic Regression Bands" by CryptoRiskAlert (TradingView, Aug 2025)
// with the same constants, plus two dashed extreme lines.
//
//   price = 10 ^ (a * ln(t) - b),   t = days since 3 Dec 2014
//   Upper band (red)   a = 0.79   b = 2.50 / 2.65   bull-market peaks (2021 tops reached it; only Jan 2018 closed above)
//   Lower band (teal)  a = 1.38   b = 8.00 / 8.30   bear-market lows (closed below only in 2015, Mar 2020 and 2026)
//   Top extreme        a = 0.79   b = 2.406         through the Jan 2018 top ($1,420)
//   Bottom extreme     a = 1.38   b = 8.492         through the 13 Mar 2020 wick ($88.20); no day has traded below it
//
// The bands depend only on the date: use it on ETHUSD, log scale, daily or weekly.
//
//@version=5
indicator("IVth Legion ETH Cycle Bands", shorttitle="IVL ETH Cycle", overlay=true)

aUp    = input.float(0.79, "Upper band slope a", step=0.01)
bUpTop = input.float(2.5, "Upper band top b", step=0.01)
bUpBot = input.float(2.65, "Upper band bottom b", step=0.01)
aLo    = input.float(1.38, "Lower band slope a", step=0.01)
bLoTop = input.float(8.0, "Lower band top b", step=0.01)
bLoBot = input.float(8.3, "Lower band bottom b", step=0.01)
showX  = input.bool(true, "Draw the extreme lines (Jan 2018 top / Mar 2020 wick)")
bXTop  = input.float(2.406, "Top extreme b", step=0.001)
bXBot  = input.float(8.492, "Bottom extreme b", step=0.001)
showTbl = input.bool(true, "Show table")

origin = timestamp("UTC", 2014, 12, 3, 0, 0)
tDays  = (time - origin) / 86400000.0
lnt    = tDays > 1 ? math.log(tDays) : na
bandAt(a, b) => math.pow(10, a * lnt - b)

xTop = bandAt(aUp, bXTop)
uTop = bandAt(aUp, bUpTop)
uBot = bandAt(aUp, bUpBot)
lTop = bandAt(aLo, bLoTop)
lBot = bandAt(aLo, bLoBot)
xBot = bandAt(aLo, bXBot)

cRed  = #F87C6B
cTeal = #62C4BE
p1 = plot(uTop, "Upper band, top", color=cRed)
p2 = plot(uBot, "Upper band, bottom", color=cRed)
p3 = plot(lTop, "Lower band, top", color=cTeal)
p4 = plot(lBot, "Lower band, bottom", color=cTeal)
fill(p1, p2, color=color.new(cRed, 75), title="Upper band")
fill(p3, p4, color=color.new(cTeal, 75), title="Lower band")
plot(showX ? xTop : na, "Top extreme", color=#ef5350, style=plot.style_circles, linewidth=1)
plot(showX ? xBot : na, "Bottom extreme", color=#00c2ff, style=plot.style_circles, linewidth=1)

zone = close > uTop ? "Above the upper band" : close >= uBot ? "Inside the upper band" : close > lTop ? "Between the bands" : close >= lBot ? "Inside the lower band" : close >= xBot ? "Below the lower band" : "Below the Mar 2020 extreme"
zoneCol = close >= uBot ? cRed : close > lTop ? color.orange : close >= lBot ? cTeal : #00c2ff

fmt(v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.0") + "%"
usd(v) => "$" + str.tostring(v, v >= 1000 ? "#,###" : "#.##")
var table tb = table.new(position.bottom_right, 3, 7, bgcolor=color.new(#0d0d18, 10), border_color=color.new(#ffffff, 85), border_width=1)
if showTbl and barstate.islast
    table.cell(tb, 0, 0, "Line", text_color=color.silver, text_size=size.small)
    table.cell(tb, 1, 0, "Today", text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 0, "Price vs line", text_color=color.silver, text_size=size.small)
    names = array.from("Upper, top", "Upper, bottom", "Lower, top", "Lower, bottom", "Mar 2020 extreme")
    vals = array.from(uTop, uBot, lTop, lBot, xBot)
    for i = 0 to 4
        v = array.get(vals, i)
        table.cell(tb, 0, i + 1, array.get(names, i), text_color=i < 2 ? cRed : i < 4 ? cTeal : #00c2ff, text_size=size.small)
        table.cell(tb, 1, i + 1, usd(v), text_color=color.white, text_size=size.small)
        table.cell(tb, 2, i + 1, fmt((close / v - 1) * 100), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 6, zone, text_color=zoneCol, text_size=size.small)
    table.merge_cells(tb, 0, 6, 2, 6)

alertcondition(ta.crossunder(low, lTop), "ETH entered the lower band", "ETH traded down into the lower band (bear-market low zone)")
alertcondition(ta.crossover(high, uBot), "ETH entered the upper band", "ETH traded up into the upper band (bull-market peak zone)")
alertcondition(ta.crossunder(low, xBot), "ETH below the Mar 2020 extreme", "ETH traded below the Mar 2020 extreme line, lower than any day in its history")
