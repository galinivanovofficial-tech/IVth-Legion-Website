# ─────────────────────────────────────────────────────────────
#  IVth Legion — environment configuration
#  Copy this file to ".env" and fill in your values.
#  Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Public base URL of your site (no trailing slash).
# Local:  http://localhost:3000
# Live:   https://fourthlegion.com
BASE_URL=http://localhost:3000

# Port the server listens on (most hosts set this automatically).
PORT=3000

# production | development
NODE_ENV=development

# ── Security ──
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=30

# The email address that should have the "admin" role (optional).
ADMIN_EMAIL=galinivanovofficial@gmail.com

# ── Stripe (payments) ──
# From https://dashboard.stripe.com/apikeys  (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxx
# Create a €89/month recurring Product/Price, then paste its price id (price_...)
STRIPE_PRICE_ID=price_xxx
# Create a €799/year recurring Price on the same Product (price_...)
STRIPE_PRICE_ID_YEARLY=price_xxx
# From your webhook endpoint settings (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shown on the marketing/subscribe pages.
PRICE_AMOUNT=89
PRICE_AMOUNT_YEARLY=799
PRICE_CURRENCY=EUR

# ── Telegram ──
# Talk to @BotFather to create a bot and get its token.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Numeric id of your private group/supergroup (e.g. -1001234567890).
# Add the bot as an admin with "Invite Users" + "Ban Users" permissions,
# then get the id from @RawDataBot or the getUpdates API.
TELEGRAM_GROUP_ID=-1001234567890
# Optional public fallback link (used only if an invite can't be generated).
TELEGRAM_GROUP_LINK=https://t.me/+yourInviteHash
# How long each single-use invite link stays valid (hours).
TELEGRAM_INVITE_HOURS=48

# ── Membership rules ──
# Days of grace after a payment lapses before Telegram access is revoked.
GRACE_DAYS=3

# Where the SQLite database file lives (use a persistent disk in production).
DATA_DIR=./data
